{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "gh-autumnnazi.log2sql",
  "name": "Log2SQL",
  "version": "0.1.0",
  "description": "粘贴 MyBatis / MyBatis-Plus 的 Preparing/Parameters DEBUG 日志，还原成可直接执行的 SQL；convert 命令同时作为 Agent 工具与 CLI 命令可用。",
  "author": "AutumnNazi",
  "license": "Apache-2.0",
  "permissions": [
    "ai.tools",
    "host.log",
    "ui.html-panel",
    "ui.pages"
  ],
  "permissionNotes": {
    "ai.tools": "把 convert 命令暴露为 Agent 工具：传入日志文本，返回回填后的 SQL，纯计算无副作用。",
    "host.log": "插件进入 running 状态时写一条诊断日志。",
    "ui.html-panel": "在插件详情与工作台标签页里渲染日志转换面板；脚本运行在沙箱 iframe 中，只可调用声明过的宿主能力。",
    "ui.pages": "把「MyBatis 日志转 SQL」页面挂到标题栏「插件页面」菜单，点击在工作台标签页打开。"
  },
  "backend": {
    "default": {
      "executable": "bin/plugin.exe",
      "runtime": "native"
    }
  },
  "window": {
    "entry": "ui/window.html",
    "title": "Log2SQL · MyBatis 日志还原",
    "width": 900,
    "height": 680
  },
  "contributes": {
    "commands": [
      {
        "id": "convert",
        "title": "MyBatis 日志转 SQL",
        "description": "供 Agent 工具与 CLI 调用的纯计算命令：在 log 字段传入 MyBatis 日志文本，返回回填后的 SQL。插件详情页的执行框需填 {\"log\":\"...\"} 形式的 JSON；日常人工转换请直接用面板粘贴日志。",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "log": {
              "type": "string",
              "maxLength": 65536,
              "description": "MyBatis DEBUG 日志原文，可含时间戳/线程前缀与多条语句"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "generic",
                "mysql"
              ],
              "default": "generic",
              "description": "SQL 方言：generic 通用回填；mysql 额外支持字符串字面量的反斜杠转义"
            }
          },
          "required": [
            "log"
          ]
        }
      },
      {
        "id": "getSettings",
        "title": "读取界面设置",
        "description": "读取 language/theme/dialect 偏好；独立窗口初始化时调用，文件缺失或损坏返回默认值。",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "id": "saveSettings",
        "title": "保存界面设置",
        "description": "把 language/theme/dialect 写入插件数据目录的 settings.json（原子写，非法取值归一到默认值）。",
        "effect": "write",
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": [
                "auto",
                "zh-CN",
                "zh-TW",
                "en-US",
                "ja-JP",
                "de-DE",
                "ru-RU"
              ]
            },
            "theme": {
              "type": "string",
              "enum": [
                "auto",
                "light",
                "dark"
              ]
            },
            "dialect": {
              "type": "string",
              "enum": [
                "generic",
                "mysql"
              ]
            }
          }
        }
      }
    ],
    "panels": [
      {
        "id": "workbench",
        "title": "MyBatis 日志转 SQL",
        "html": {
          "source": ""
        }
      }
    ],
    "pages": [
      {
        "id": "workbench",
        "title": "MyBatis 日志转 SQL",
        "html": {
          "source": ""
        }
      }
    ],
    "navigation": [
      {
        "id": "workbench-tools",
        "title": "MyBatis 日志转 SQL",
        "page": "workbench",
        "location": "tools",
        "order": 0
      }
    ]
  }
}
